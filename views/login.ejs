<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <link rel="stylesheets" href="/stylesheet/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
</head>
<body>
    <div class="main w-full min-h-screen bg-blue-300 p-5 text-white">
        <h5 class="text-2xl tracking-tighter mb-2 md-2">Login Page</h5>
        <form action="/login" method="post" class="flex gap-3 flex-wrap py-2">
            <input class="block px-3 py-2 border-2 border-blue-100 rounded-lg text-black" name="email" type="email" placeholder="Type your email"></input>
            <input class="block px-3 py-2 border-2 border-blue-100 rounded-lg text-black" name="password" type="password" placeholder="Type your password"></input>
            <input class="block px-3 py-2 border-2 rounded-lg bg-blue-400 ml-2" type="submit" name="login" value="Login">
        </form>
    </div>
</body>
</html>